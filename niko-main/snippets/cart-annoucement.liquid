</svg>
    <p class="new-annc-text rf-new-annc-text-{{ section.id }}">{{ progress_message }}</p>
  </div>
    <div
      class="cpg-bar rf-cpg-bar-{{ section.id }}"
      data-progress="{{ discount_level }}"
      style="--progress:{% if discount_level == 10 %}26{% elsif discount_level == 20 %}52{% elsif discount_level >= 30 %} 100{% endif %}%;"
    >
      <div class="progress-lines rf-progress-line-{{ section.id }}"><span></span></div>
      <div class="progress-circles rf-progress-circle-{{ section.id }}">
        <div class="progress-circle circle1 {% if discount_level >= 10 %} filled {% endif %}">
          <span class="inside-line"></span>
          <span class="pc-text">10%</span>
        </div>
        <div class="progress-circle circle2  {% if discount_level >= 20 %} filled {% endif %}">
          <span class="inside-line"></span>
          <span class="pc-text">15%</span>
        </div>
        <div class="progress-circle circle3  {% if discount_level >= 30 %} filled {% endif %}">
          <span class="inside-line"></span>
          <span class="pc-text">20%</span>
        </div>
      </div>
      {% comment %} <div class="progress-labels">
        <div class="progress-label label1">2 Artikel</div>
        <div class="progress-label label1">3 Artikel</div>
        <div class="progress-label label1">4 Artikel</div>
      </div> {% endcomment %}
    </div>
  </div>
{% endif %}
