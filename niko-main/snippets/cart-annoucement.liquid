<style>
  .rf-icon-annc-{{ section.id }}{
  display: flex;
  align-items: start;
  justify-content: start;
  gap:.9em;
  }
  .rf-new-annc-text-{{ section.id }}{
  text-align:left;
}
.rf-icon-annc-{{ section.id }} svg{
min-width:25px !important;
min-height:25px !important;
width:25px !important;
height:25px !important;
margin-top:3px;
}
</style>


{% assign total_quantity = 0 %}
<!-- To track the total quantity of products from announcement collections -->
{% assign discount_level = 0 %}
<!-- To determine the applicable discount level -->

{% for item in cart.items %}
  <!-- Check if the product belongs to an announcement collection -->
  {% for collection in item.product.collections %}
    {% if collection.metafields.custom.annoucement != blank %}
      <!-- Add the item's quantity to the total -->
      {% assign total_quantity = total_quantity | plus: item.quantity %}
      {% break %}
      <!-- Break to prevent double-counting the same product in multiple collections -->
    {% endif %}
  {% endfor %}
{% endfor %}

<!-- Determine the discount level based on the total quantity -->
{% case total_quantity %}
  {% when 2 %}
    {% assign discount_level = 10 %}
  {% when 3 %}
    {% assign discount_level = 20 %}
  {% when 4, more %}
    {% assign discount_level = 30 %}
  {% else %}
    {% assign discount_level = 0 %}
{% endcase %}

<!-- Set the progress message -->
{% assign progress_message = '' %}
{% case total_quantity %}
  {% when 0 %}
    {% assign progress_message = settings.annc_zero | default: 'Du hast noch keinen Rabatt für diesen Artikel.' %}
  {% when 1 %}
    {% assign progress_message = settings.annc_one | default: 'Noch 1 Artikel und du sparst 10%' %}
  {% when 2 %}
    {% assign progress_message = settings.annc_two | default: 'Super, Du hast dir 10% Rabatt gesichert!' %}
  {% when 3 %}
    {% assign progress_message = settings.annc_three | default: 'Noch 1 Artikel und du sparst 15%!  ' %}
  {% when 4, more %}
    {% assign progress_message = settings.annc_four | default: 'Noch 1 Artikel und du sparst 20%!' %}
{% endcase %}

<!-- Display the progress and discount information -->
<template>
  <p>Total Announcement Collection Quantity: {{ total_quantity }}</p>
  <p>Applicable Discount Level: {{ discount_level }}%</p>
  <p>Progress Message: {{ progress_message }}</p>
</template>

{% if total_quantity > 0 %}
  <div
    class="newly-cpg-wrap rf-newly-wrap-{{ section.id }}"
    data-proccessed-items="{{ processed_items }}"
    data-count-annoucements="{{ total_quantity }} Artikel"
    data-annouce-message="{{ progress_message }}"
    data-discount="{{ discount_level }}%"
  >
    <div class="rf-icon-annc-{{ section.id }}">
     <svg xmlns="http://www.w3.org/2000/svg" fill="#5bae50" width="25px" height="25px" viewBox="0 0 32 32" version="1.1" >
<title>gift</title>
