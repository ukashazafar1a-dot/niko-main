<script type="application/ld+json" id="calculator-data">
  {
    "tag": "custom-neon",
    "productInfo": {
        "title": "{{product.title}}",
        "handle": "{{ product.handle }}",
        "image": "https:{{product.featured_image | img_url: 'original'}}",
        "weight": "{{ product.selected_or_first_available_variant.weight_in_unit }}",
        "weight_unit":"{{ product.selected_or_first_available_variant.weight_unit }}",
        "requires_shipping": {{ product.selected_or_first_available_variant.requires_shipping }}
    },
    "settings": {
      "payment_icons": "{{ section.settings.delivery_icons | image_url }}",
      "point_one":  "{{ section.settings.custom_pone }}",
      "shipping_text": "{{ section.settings.shipping_text | strip_newlines }}",
      "discount_enable": {{ section.settings.discount_enable }},
      "discount": {{ section.settings.discount }},
      "reviews_note_enable": {{ section.settings.reviews_note_enable }},
      "reviews_note_text": "{{  section.settings.reviews_note_text }}",
      "reviews_note_check": "{{ section.settings.reviews_note_check | image_url: width: 16 }}",
      "reviews_note_img_1": "{{ section.settings.reviews_note_img_1 | image_url: width: 32 }}",
      "reviews_note_img_2": "{{ section.settings.reviews_note_img_2 | image_url: width: 32 }}"
    },
    "content": {
      "title_top_note": "{{ section.settings.title_top_note }}",
      "title_bottom_text": "{{ section.settings.title_bottom_text | escape }}",
      "size_chart_label": "{{ section.settings.size_chart_label }}",
      "size_chart_img": {% if product.metafields.custom.sizechart %}"{{ product.metafields.custom.sizechart | image_url: width: 3840 }}"{% else %}null{% endif %},
      "discount_note_label": "{{ section.settings.discount_note_label }}",
      "discount_note_action_text": "{{ section.settings.discount_note_action_text }}",
      "discount_note_img": {% if section.settings.discount_note_img %}"{{ section.settings.discount_note_img | image_url: width: 3840 }}"{% else %}null{% endif %}
    }
  }
</script>
