{% comment %} <style>
  #neon-icons-customiser-app{
      margin: 2rem 0;
  }
</style> {% endcomment %}

{% if section.settings.shipping_text != blank %}
  {% style %}
    #delivery-text {
        color: #008b10;
        font-family: 'Goudy Old Style', serif;
        font-weight: bold;
        margin: 0;
        padding: 0;
        font-size: 20.5px;
        text-align: left;
        /* Standard-Schriftgröße, die du anpassen kannst */
    }
  {% endstyle %}
{% endif %}

<div id="neon-icons-customiser-app" class="hello" data-handle="{{ product.handle }}"></div>

