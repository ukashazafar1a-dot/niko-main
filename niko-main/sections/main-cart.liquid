<script>
  const getData = async () => {
    try {
          // Create a new Promise that resolves after a 2-second delay
          await new Promise((resolve) => setTimeout(resolve, 2000));

          // Fetch the cart details
          let response = await fetch("/cart.js");
          let cart = await response.json();
          //console.log(cart);

          var totalPrice = cart.total_price;

          var freeShippingThreshold = 5000; // Free shipping threshold in cents
          var remainingAmount = freeShippingThreshold - totalPrice;

          var file = document.getElementById("file");
          var progressLabel = document.getElementById("progressLabel");
          progressLabel.innerHTML = `<p>Sparen Sie nur noch bis zu 50 Euro für kostenlosen Versand!</p>`
          var cartTopWrapper = document.getElementById("cartTopWrapper");
        
          if (totalPrice >= freeShippingThreshold) {
            progressLabel.innerHTML =
              "<p>Glückwunsch! Du erhältst kostenlosen Versand!</p>";
            cartTopWrapper.className = "cart_top_wrapper bottom_progress";
            file.value = 5000; // Max value for the progress bar
          } else {
            progressLabel.innerHTML = `Super! Nur noch ${(
              remainingAmount / 100
            ).toFixed(2)} Euro für den kostenlosen Versand!`;
            cartTopWrapper.className = "cart_top_wrapper top_progress";
            file.value = totalPrice;
          }

        //  console.log("Total price set to progress value:", totalPrice);
        } catch (error) {
          console.error("Error fetching cart:", error);
        }
  }
  document.addEventListener('DOMContentLoaded', function() {
    getData();
 });
</script>

