<style>
  .timer-block,
  .timer-block .custom-delivery-date__wrapper{
    margin:0;
  }
  .timer-block .custom-delivery-date{
    justify-content:center;
  }
  .cart__page-col:nth-child(2) {
    box-shadow: 0px 0px 2px 2px #e9e9e9;
}
  .cart__item-sub.cart__item-now:nth-child(2) {
    display: none;
}
</style>

{% style %}
  :root{
    --cart-annc-color: {{ section.settings.annc_clr }};
    --cart-annc-textcolor: {{section.settings.annc_text_clr}};
    --cart-cgp-color: {{section.settings.cgp_clr}};
    --cart-cgp-textclr: {{section.settings.cgp_text_clr}};
    --cart-cgp-borderclr: {{ section.settings.cgp_border_clr}};
  }
  .progress-bar{
    display:none;
  }
  .newly-cpg-wrap{
    max-width:600px;
    width:100%;
    margin:2rem auto;
  }
  .new-annc-text{
    margin:0 ;
    text-align:center;
  }
  .cpg-bar{
    position:relative;
    min-height:80px;
    --light-green: var(--cart-cgp-color);
    color: var(--cart-cgp-textclr);
  }
  .progress-lines{
    border: 2px solid var(--cart-cgp-borderclr);
    border-radius:4px;
    position:absolute;
    inset:0;
    width:100%;
    height:16px;
    top:17px;
    z-index:0;
    --only: 0%;
    background: linear-gradient(to right, var(--light-green) var(--progress), #ffffff var(--only));
  }
  .cpg-bar .progress-circles{
    display:flex;
    align-items:center;
    justify-content:space-evenly;
    padding:5px 0 5px 0;
  }
  .progress-labels{
    display:flex;
    align-items:center;
    justify-content:space-evenly;
  }
  .progress-circle{
    width:40px;
    height:40px;
    border: 2px solid var(--cart-cgp-borderclr);
    background:white;
    border-radius:50%;
    position:relative;
    z-index:1;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .progress-circle.filled{
    background: var(--light-green);
  }
  .progress-circle.filled .inside-line {
    background: var(--light-green);
  }
  .pc-text{
    z-index:1;
    font-size:14px;
  }
  .inside-line{
    position: absolute;
    width: 44px;
    height: 12px;
    top: 12px;
    z-index: 0;
    background: white;
    margin-left: -2px;
  }
  .filled{
    background: var(--light-green);
  }
  .cart__item .cart__discount{
    color:black;
  }
  .cart__item-price-col.text-right{
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap: wrap
  }
  .cart__price.cart__discount{
    color:red;
  }
  .cart--amount .cut-red{
    color:red;
    padding-left:5px;
  }
  [data-cart-amount] .cart__item-sub{
    margin-bottom:15px;
  }
{% endstyle %}
<script>
  setTimeout(() => {
    const targetDiv = document.querySelector('div[style="text-align: right; font-weight: normal; font-size: 11px; position: absolute; bottom: 0px; right: 5px;"]');
    if (targetDiv) {
        targetDiv.style.display = 'none';
    }
}, 3000);

</script>
