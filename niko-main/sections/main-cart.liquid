    <h1 class="section-header__title">{{ 'cart.general.title' | t }}</h1>
  </header>

  <div class="progress-bar">
    <div class="cart_top_wrapper" id="cartTopWrapper">
      <div class="cart-top-bar-inner">
        <label for="file" id="progressLabel"></label>
        <progress id="file" value="0" max="5000"></progress>
      </div>
    </div>
  </div>
  {% render 'cart-timer', section: section %}
  {% include 'cart-annoucement' %}
  {%- if cart.item_count > 0 -%}
