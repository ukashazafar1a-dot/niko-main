{%- liquid
  assign isModal = false
  if template == 'product.modal'
    assign isModal = true
  endif
-%}
{% style %}
  .img_icon_product_setup img {
    object-fit: cover;
}
  p.review_note_pr {
    font-family: 'Roboto';
    font-size: 14px;
    letter-spacing: 0;
  
}
.cta_point_text {
    padding: 5px 0 5px 0;
    font-family: 'Roboto';
    font-size: 14px;
    border-top: 1px solid #e8e8e8;
    margin-top: 12px;
    border-bottom: 1px solid #e8e8e8;
    margin-bottom: 12px;
}
  .product-single__meta .variant__button-label{
    margin: 0 8px 0px 0;
  }

  .product-single__meta label.variant__label {
    font-family: 'Roboto';
    padding-bottom: 9px;
    letter-spacing: 0;
    text-transform: none;
    font-weight: normal;
}
 .product-single__meta .product-block.product-block--price {
    font-family: 'Roboto';
    letter-spacing: 0;
    font-size: 15px;
    padding-top: 9px;
}
 .product-single__meta .rte p {
    font-family: 'Roboto';
    letter-spacing: 0;
    font-size: 15px;
    margin: 10px 0;
    /* line-height: 29px; */
}
  .point_manage_cta_pr span {
    font-weight: 600;
}

.point_manage_cta_pr img {
    width: 70px;
}
.point_manage_cta_pr {
    display: flex
;
    align-items: center;
}
  .point_manage_cta_pr {
    display: flex;
    align-items: center;
    width: 50%;
}


  .cta_point_bpr {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    row-gap: 2px;
}
  .product-single__meta .variant__button-label {
    margin: 0 8px 5px 0;
    overflow: visible !important;
}
  .variant-input-wrap input[type=radio]:checked+label::before {
    content: " ";
    position: absolute;
    width: 23px; /* Increased size for spacing */
    height: 23px;
    background: #000;
    top: -11px; /* Adjusted for spacing */
    right: -15px !important; /* Adjusted for spacing */
    border-radius: 50%;
    color: #fff;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    background-image: url(https://cdn.shopify.com/s/files/1/0765/1301/8186/files/hd-white-tick-mark-icon-transparent-background-701751695051247opp5aqwrto-removebg-preview.png?v=1739264316);
    background-size: 60%; /* Reduce size to add spacing */
    background-repeat: no-repeat;
    background-position: center;
    padding: 5px; /* Adds space around the image */

}

  .product-block.product-block--price {
    border-top: 1px solid #e8e8e8;
    border-bottom: 1px solid #e8e8e8;
    margin-top: 28px !important;
    padding-bottom: 11px;
}
  .product__price-savings {
    color: var(--colorTextSavings);
    background: #008b10;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 14px;
    position: relative;
    top:-4px;
}
  span.product__price-savings::before {
    border-color: #008b10;
    border-style: solid;
    border-width: 4px 11px 9px 0;
    content: "";
    left: -4px;
    position: absolute;
    top: 3px;
    z-index: 0;
    transform: rotate(45deg);
}
  span.product__price.product__price--compare {
    color: #646464;
    font-size: 16px;
}
  .product__policies.rte.small--text-center {
    font-size: 11px;
    color: #646464;
}
  span.product__price-savings-note {
    font-size: 14px;
}
  button.btn.btn--full.add-to-cart {
    background: #000;
    color: #fff;
}
      .variant-input-wrap label {
        font-size:14px;
    }

  @media screen and (min-width:750px){
    .point_manage_cta_pr img {
        width: 55px;
        height: 35px;
        object-fit: contain;
    }
    .point_manage_cta_pr span {
        font-weight: 600;
        font-size: 14px;
    }
  }
    @media screen and (max-width:750px){
      .point_manage_cta_pr img {
    width: 50px;
    height: 35px;
    object-fit: contain;
}
        .point_manage_cta_pr span {
    font-weight: 600;
          font-size:14px;
}
    .varients--flexs .varients-selectors-wrapper .variant-input-wrap {
        max-width: max-content !important;
    }
  }
    @media screen and (max-width:750px){
        .product-block.varients--flexs {
    position: relative;
}
    .size-chart__standalone.size-guide-popup {
    position: absolute;
    top: 75px;
    right: 0;
}
    .tool-tip-trigger.tool-tip-trigger span {
    font-size: 14px;
    /* font-weight: 600; */
}
      .product-block.product-block--price div{
        width: 100%;
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
      }
      span.product__policies.rte.small--text-center {
    margin: 0;
    padding-right: 20px;
}
      .template-product .index-section {
     /* margin: unset !important; */
}
  }
  {% endstyle %}
{%- render 'product-template',
  product: product,
  section_id: section.id,
  blocks: section.blocks,
  image_position: section.settings.image_position,
  image_container_width: section.settings.image_size,
  product_zoom_enable: section.settings.product_zoom_enable,
  sku_enable: section.settings.sku_enable,
  isModal: isModal,
  thumbnail_position: section.settings.thumbnail_position,
  thumbnail_height: section.settings.thumbnail_height,
  thumbnail_arrows: section.settings.thumbnail_arrows,
  mobile_layout: section.settings.mobile_layout,
  video_looping: section.settings.enable_video_looping,
  video_style: section.settings.product_video_style,
  context: 'main-product'
-%}

