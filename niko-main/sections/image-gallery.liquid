

<div
  class="gallery-section gallery-{{ section.id }}{% if section.settings.color_background == settings.color_body_bg %} gallery-section--with-divider{% endif %} text-{{ section.settings.align_text }}"
  data-section-id="{{ section.id }}"
  data-section-type="gallery"
  data-aos>
  {%- if section.settings.title != blank -%}
    <div class="page-width">
      <div class="section-header">
        <h2>{{ section.settings.title | escape }}</h2>
      </div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="slideshow-wrapper">
      <div
        class="gallery-slider"
        id="Gallery-{{ section.id }}"
        data-dots="true"
        data-count="{{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          <div
            class="gallery-slide gallery-slide--{{ block.id }} wise-reviews-element "
            data-index="{{ forloop.index0 }}"
            data-aos="row-of-{{ section.blocks.size }}"
            {{ block.shopify_attributes }}>
            <blockquote class="gallery-slider__text">
              {%- if block.settings.image != blank -%}
                <div class="gallery-image{% if section.settings.round_images %} gallery-image--round{% endif %}">
                  <div class="image-wrap"
                    {% if section.settings.round_images == false %}
                      style="height: 0; padding-bottom: {{ 100 | divided_by: block.settings.image.aspect_ratio }}%;"
                    {% endif %}
                  >
                    {%- liquid
                      if section.settings.round_images
                        assign sizeVariable = '65px'
                      else
                        assign sizeVariable = '142px'
                      endif

                      assign fallback = sizeVariable
                    -%}
                    {%- render 'image-element',
                      img: block.settings.image,
                      sizeVariable: sizeVariable,
                      fallback: fallback,
                      widths: '180, 360, 540, 720',
                    -%}
                  </div>
                </div>
                {% render 'product-star-reviews', stars: block.settings.stars %}
                <div class="wise-review-content-container wise-p-3 md:wise-p-4">
                  <div class="wise-block wise-truncate">
                    <div class="wise-mb-4 wise-flex wise-items-center">
                      <div class="wise-flex wise-items-center">
                        {% if block.settings.user_image != blank %}
                          <img loading="lazy" src="{{ block.settings.user_image | image_url }}" alt="{{ block.settings.user_image.alt }}" class="wise-w-10 wise-h-10 wise-rounded-full">
                        {% else %}
                          <div class="wise-w-10 wise-h-10 wise-rounded-full wise-aspect-square wise-font-semibold wise-justify-center wise-items-center wise-flex wise-text-black wise-bg-slate-200">{{ block.settings.user_letter }}</div>
                        {% endif %}
                        <img src="https://wise-reviews.assets.codexapps.co/assets/verified.png" alt="Verified" loading="lazy" class="wise-w-5 wise-h-5 -wise-ml-[15px] wise-mt-[25px]">
                      </div>
                      <div class="wise-ml-2">
                        <div class="wise-font-medium wise-truncate wise-text-black dark:wise-text-white">{{ block.settings.name }}</div>
                      </div>
                    </div>
                  </div>
                  {% if block.settings.description != blank %}
                    <div class="rte">
                      <p>{{ block.settings.description }}</p>
                    </div>
                  {% endif %}
                </div>
              {%- endif -%}
            </blockquote>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Image Gallery",
  "max_blocks": 30,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.testimonials.settings.title.label",
      "default": "Inspirationen und Kundenbewertungen"
    },
    {
      "type": "checkbox",
      "id": "round_images",
      "label": "Circular Images",
      "info": "Require square images",
      "default": true
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#f9f9f9"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Reviews"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "image_picker",
          "id": "user_image",
          "label": "User Image"
        },
        {
          "type": "text",
          "id": "user_letter",
          "label": "Profile Image Placeholder",
          "info": "If image is not provided then will use this letter instead."
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "new_desc",
          "label": "New Desc"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}